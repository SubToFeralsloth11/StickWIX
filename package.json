{
  "name": "stickwix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "No-code 2D game engine: stickers, sentence rules and Show-me.",
  "scripts": {
    "dev": "vite",
    "build:player": "vite build --config vite.player.config.ts && tsx scripts/check-player-size.ts",
    "build": "pnpm build:player && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "assets": "tsx scripts/fetch-builtin-assets.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "immer": "^11.0.0",
    "pixi.js": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@12.9.1"
}
